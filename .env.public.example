PUBLIC_HOST=your-domain.example.com

POSTGRES_DB=business_ai
POSTGRES_USER=business_ai
POSTGRES_PASSWORD=change-this-password

FASTGPT_BASE_URL=https://your-fastgpt.example.com
FASTGPT_API_KEY=
FASTGPT_DATASET_ID=
FASTGPT_DATASET_UPSERT_PATH=/api/core/dataset/data_push
FASTGPT_CHAT_PATH=/chat/completions

# 投后监测报告模型。DeepSeek 兼容 OpenAI Chat Completions；Key 留空时使用确定性报告草稿。
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_CHAT_PATH=/chat/completions
SERPER_API_KEY=

# 内部单账号。生产环境必须启用并使用 Secret 注入密码或 PBKDF2 哈希。
AUTH_REQUIRED=true
APP_USERNAME=admin
APP_PASSWORD=
APP_PASSWORD_HASH=
SESSION_SECRET=change-to-a-long-random-secret
SESSION_TTL_HOURS=12

UPLOAD_ROOT=/data/uploads
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_PAGES=200
INLINE_JOB_EXECUTION=false
COMPANY_PROFILE_WORKER_ENABLED=true

# 单公司客户演示。留空 DEMO_COMPANY_NAME 即恢复多公司模式。
DEMO_COMPANY_NAME=上海携程金融信息服务有限公司
DEMO_REPORT_AS_OF_DATE=2026-09-24

# Optional. When unset, the company detail page falls back to the local company profile.
QICHACHA_ENABLED=true
QICHACHA_APP_KEY=
QICHACHA_SECRET_KEY=

# Windows/macOS 企业全景采集 Worker 专用。请使用至少 32 位随机值。
COLLECTION_API_KEY=

CSRC_MONITOR_ROOT_HOST=./data/csrc-monitor
